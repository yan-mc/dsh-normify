{
  "name": "@dsh-external/dsh-normify",
  "version": "0.5.5",
  "description": "Normify（归一化框架图构建器）：人机共读的分形项目结构图系统——模块树源数据零容忍校验/编译/渲染，以及 AI 结构数据生成器（31 个工具 + normify-gen 技能 + 渲染数据集 + 伴随开发）。0.5.5：适配 DeepSeek Harness 0.2.x（只支持当前最新版）、安全三破口修复、receipt 自哈希修复、数据正确性与原子写。",
  "type": "module",
  "main": "./lib/dsh/index.js",
  "types": "./lib/types/dsh/index.d.ts",
  "files": [
    "lib",
    "skills",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "yan-mc",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-skill",
    "architecture",
    "structure-diagram",
    "module-tree",
    "normify"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yan-mc/dsh-normify.git"
  },
  "bugs": {
    "url": "https://github.com/yan-mc/dsh-normify/issues"
  },
  "homepage": "https://github.com/yan-mc/dsh-normify#readme",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/cosmokit": "^1.8.3",
    "@standard-schema/spec": "^1.1.0"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node tests/engine-e2e.mjs && node tests/companion-e2e.mjs && node tests/regression-0.5.2.mjs && node tests/regression-0.5.3.mjs && node tests/regression-0.5.4.mjs && node tests/regression-0.5.5.mjs",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "cli": "node lib/cli/index.js"
  },
  "bin": {
    "normify": "./lib/cli/index.js"
  }
}
