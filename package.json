{
  "name": "@dsh-external/dsh-normify",
  "version": "0.5.5",
  "description": "Normify（结构编译器）：人机共读的分形模块树结构数据——模块源数据零容忍校验、确定性编译（含结构 SBOM 回执）、单文件交互架构图与伴随开发流程；31 个 normify_* 工具 + normify-gen 技能 + 跨 agent CLI。只支持当前最新 DSH（0.2.x）。",
  "type": "module",
  "main": "./lib/dsh/index.js",
  "types": "./lib/types/dsh/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/types/dsh/index.d.ts",
      "default": "./lib/dsh/index.js"
    },
    "./core": {
      "types": "./lib/types/core/index.d.ts",
      "default": "./lib/core/index.js"
    },
    "./cli": "./lib/cli/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "vendor",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "yan-mc",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-skill",
    "architecture",
    "architecture-as-code",
    "structure-sbom",
    "structure-compiler",
    "module-tree",
    "normify"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yan-mc/dsh-normify.git"
  },
  "bugs": {
    "url": "https://github.com/yan-mc/dsh-normify/issues"
  },
  "homepage": "https://github.com/yan-mc/dsh-normify#readme",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "testedDshVersion": "0.2.1-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/cosmokit": "^1.8.3",
    "@standard-schema/spec": "^1.1.0"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node tests/engine-e2e.mjs && node tests/companion-e2e.mjs && node tests/regression-0.5.2.mjs && node tests/regression-0.5.3.mjs && node tests/regression-0.5.4.mjs && node tests/regression-0.5.5.mjs",
    "test:perf": "node tests/perf-smoke.mjs",
    "test:contract": "node tests/platform-contract.mjs && node scripts/pack-smoke.mjs --contract",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "cli": "node lib/cli/index.js",
    "test:unit": "node tests/core-unit.mjs",
    "test:drift": "node scripts/dsh-contract-diff.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:unit && npm run test:perf && npm run test:contract"
  },
  "bin": {
    "normify": "./lib/cli/index.js"
  }
}
