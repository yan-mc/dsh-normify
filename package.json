{
  "name": "@dsh-external/dsh-normify",
  "version": "0.5.1",
  "description": "Normify（归一化框架图构建器）：人机共读的分形项目结构图系统——模块树源数据零容忍校验/编译/渲染，以及 AI 结构数据生成器（30 个工具 + normify-gen 技能 + 渲染数据集 + 伴随开发）。适配 DeepSeek Harness 0.1.5+ / DSHEAC AIO 桌面端。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "skills",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "yan-mc",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-skill",
    "architecture",
    "structure-diagram",
    "module-tree",
    "normify"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yan-mc/dsh-normify.git"
  },
  "bugs": {
    "url": "https://github.com/yan-mc/dsh-normify/issues"
  },
  "homepage": "https://github.com/yan-mc/dsh-normify#readme",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.5-rc.2 <0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-skill": ">=0.1.5-rc.2 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/cosmokit": "^1.8.3",
    "@standard-schema/spec": "^1.1.0"
